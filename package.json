{
  "name": "@titabash/kugutsu",
  "version": "0.0.28",
  "description": "AI-powered parallel development system with multiple AI engineers",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "build": "tsc",
    "build:cli": "tsc",
    "start": "node dist/index.js",
    "kugutsu": "node dist/parallel-dev-cli.js",
    "dev": "tsx src/index.ts",
    "parallel-dev-cli": "tsx src/parallel-dev-cli.ts",
    "electron": "npm run electron:build && electron ./out/main/index.js",
    "electron:dev": "electron-vite dev",
    "electron:build": "electron-vite build",
    "electron:preview": "electron-vite preview",
    "pack": "npm run electron:build && electron-builder --dir",
    "dist": "npm run electron:build && electron-builder",
    "dist:mac": "npm run electron:build && electron-builder --mac",
    "dist:win": "npm run electron:build && electron-builder --win",
    "dist:linux": "npm run electron:build && electron-builder --linux",
    "version": "echo \"@titabash/kugutsu version: $(node -p \"require('./package.json').version\")\"",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:providers": "NODE_OPTIONS=--experimental-vm-modules jest tests/providers",
    "test:nodes": "NODE_OPTIONS=--experimental-vm-modules jest tests/graph/nodes",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest tests/integration",
    "test:e2e": "npm run electron:build && playwright test",
    "test:e2e:ui": "npm run electron:build && playwright test --ui",
    "test:e2e:debug": "npm run electron:build && PWDEBUG=1 playwright test",
    "verify:e2e-minimal": "tsx tests/manual/e2e-minimal-verification.ts",
    "verify:e2e-realistic": "tsx tests/manual/e2e-realistic-verification.ts",
    "electron:test-repo": "tsx tests/manual/launch-electron-with-test-repo.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.30",
    "@anthropic-ai/claude-code": "^1.0.68",
    "@langchain/core": "^1.1.0",
    "@langchain/langgraph": "^1.0.1",
    "@openai/codex-sdk": "^0.55.0",
    "@radix-ui/react-label": "^2.1.8",
    "@types/dagre": "^0.7.53",
    "ai": "^5.0.98",
    "ai-sdk-provider-gemini-cli": "^1.3.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "async-mutex": "^0.5.0",
    "blessed": "^0.1.81",
    "chalk": "^5.4.1",
    "chokidar": "^5.0.0",
    "dagre": "^0.8.5",
    "electron": "^28.3.3",
    "lucide-react": "^0.559.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rete": "^2.0.6",
    "rete-area-plugin": "^2.1.5",
    "rete-connection-plugin": "^2.0.5",
    "rete-context-menu-plugin": "^2.0.6",
    "rete-react-plugin": "^2.1.0",
    "rete-render-utils": "^2.0.3",
    "rete-scopes-plugin": "^2.1.1",
    "strip-ansi": "^7.1.0",
    "styled-components": "^6.1.19",
    "vite": "^7.2.4",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/blessed": "^0.1.25",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@xyflow/react": "^12.9.3",
    "electron-vite": "^4.0.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^27.0.1",
    "playwright": "^1.56.1",
    "tailwindcss": "^4.1.17",
    "ts-jest": "^29.4.5",
    "tsx": "^4.7.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "bin": {
    "kugutsu": "./dist/parallel-dev-cli.js"
  },
  "files": [
    "dist",
    "electron",
    "docs",
    "README.md",
    "LICENSE",
    "CLAUDE.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./parallel-dev-cli": {
      "import": "./dist/parallel-dev-cli.js",
      "types": "./dist/parallel-dev-cli.d.ts"
    }
  },
  "keywords": [
    "ai",
    "development",
    "parallel",
    "claude",
    "automation",
    "cli"
  ],
  "author": "titabash",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/titabash/kugutsu.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com/"
  },
  "bugs": {
    "url": "https://github.com/titabash/kugutsu/issues"
  },
  "homepage": "https://github.com/titabash/kugutsu#readme"
}
